# Copy to .env and fill in. .env is gitignored; this template is not —
# so this file must never contain a real key.
#
# The key needs these scopes (ElevenLabs dashboard -> API Keys -> edit):
#   text_to_speech   scripts/generate_voice.py
#   convai_read      scripts/lock_agent_allowlist.py --check
#   convai_write     scripts/lock_agent_allowlist.py (applying the allowlist)
# A 401 with status "missing_permissions" means the key is valid but is
# missing one of these — it does not mean the key is wrong or revoked.
ELEVENLABS_API_KEY=sk_your_key_here
