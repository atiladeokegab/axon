# Never commit real credentials
firmware/config/device_secrets.py

__pycache__/
*.pyc
.venv/

# Downloaded MicroPython firmware images (get them from micropython.org;
# see docs/DEPLOY.md - the STANDARD ESP32_GENERIC_S3 build for the Genesis
# Mini's N4R2, NOT the SPIRAM_OCT variant the old Goouuu board needed)
bin/
*.bin

# Per-subject calibration output
calibration_ch*.json
pose_capture.json
pose_capture_*.json

# eleven_labs/ and webapp_demo/ were excluded wholesale while the control
# system was the only reviewable history. They are now part of the demo, so
# they are tracked — each carries its own .gitignore covering its venv,
# caches and downloaded model weights.

# Secrets, everywhere. The .env.example templates ARE committed and must
# therefore only ever hold placeholders.
.env
.env.*
!.env.example
eleven_labs/API_keys/
*.key
*.pem

# Downloaded model weights: multi-MB, fetched by scripts/download_pose_model.py
# and reproducible from it, so there is no reason to carry them in git.
models/
*.task
*.pt

# Photos of a real person's arm taken during pad calibration.
calib_*.png
demo_overlay_*.png
scratch_*.png
scratch_*.png.b64
